Options -MultiViews

# Custom 404 (generated by tools/build-pages.js). Path only — a full URL
# here would make Apache send a redirect instead of a real 404 status.
ErrorDocument 404 /404.html
RewriteEngine On

# --- 0. Dev-only files never get served. The whole repo may be uploaded as
# the docroot, and tools/ holds the full unit-level inventory export, so
# tools/, docs/, design-reference/, dotfiles/dirs (.git, .claude, .vscode)
# and markdown files answer 404 instead of their contents.
RewriteRule ^(tools|docs|design-reference)(/|$) - [R=404,L]
RewriteRule (^|/)\.(?!well-known/) - [R=404,L]
RewriteRule \.md$ - [R=404,L]

# --- 1. Old "Taony" slug (typo) -> canonical Tawny URL. Unconditional on
# host/scheme so a taony request lands on the FULL canonical URL directly,
# in one hop, instead of first getting host/scheme-fixed here and then
# needing a second hop through rule 2 to fix the slug too.
# Covers: /projects/hyde-park-taony, /projects/hyde-park-taony/,
# /projects/hyde-park-taony.html, /projects/hyde-park-taony/index.html
# (any host, any scheme, with or without trailing slash).
RewriteRule ^projects/hyde-park-taony(/index)?(\.html)?/?$ https://www.explorerhydepark.com/projects/hyde-park-tawny [R=301,L]

# --- 1a. Old project slugs (pricing keys used as URLs in an earlier build;
# /projects/hyde-central is still in Google's index). One 301 straight to
# the canonical URL, any host/scheme, with or without .html / trailing slash.
RewriteRule ^projects/hyde-central(/index)?(\.html)?/?$ https://www.explorerhydepark.com/projects/hyde-park-central [R=301,L]
RewriteRule ^projects/hyde-new-cairo(/index)?(\.html)?/?$ https://www.explorerhydepark.com/projects/hyde-park-new-cairo [R=301,L]
RewriteRule ^projects/hyde-terraces(/index)?(\.html)?/?$ https://www.explorerhydepark.com/projects/hyde-park-terraces [R=301,L]
RewriteRule ^projects/(garden-lakes|hyde-park-garden-lakes)(/index)?(\.html)?/?$ https://www.explorerhydepark.com/projects/hyde-park-garden-lake [R=301,L]
RewriteRule ^projects/(seashore|hyde-park-seashore)(/index)?(\.html)?/?$ https://www.explorerhydepark.com/projects/hyde-park-sea-shore [R=301,L]

# --- 1b. "index"/"index.html" is the docroot's DirectoryIndex file, not a
# distinct page — must 301 straight to the site root in one hop. Without
# this, rule 2's generic ".html"-stripping capture would turn
# "/index.html" into "/index" (stripping only the extension), which then
# passes rule 3's extensionless->.html check and serves 200 — a duplicate
# homepage at a non-canonical URL. Unconditional on host/scheme, same
# pattern as rule 1, and must run before rule 2 for the same reason.
RewriteRule ^index(\.html)?/?$ https://www.explorerhydepark.com/ [NC,R=301,L]

# --- 2. Canonical host + scheme + no .html + no trailing slash, all fixed
# in a single 301 (never chained). Phase 2a flags requests that are safe to
# rewrite the trailing slash off of (the homepage, or any path that isn't a
# real on-disk directory) so a genuine directory keeps working normally.
# Phase 2b fires only when something is actually non-canonical, using a
# capture over the untouched original request line (THE_REQUEST) so host,
# scheme, ".html" and a trailing slash are all corrected together.
RewriteCond %{REQUEST_URI} =/ [OR]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ - [E=CANON_OK:1]

RewriteCond %{ENV:CANON_OK} =1
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\.explorerhydepark\.com$ [NC,OR]
RewriteCond %{THE_REQUEST} \.html[/?\s] [NC,OR]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/+.+/(?:\?\S*)?\sHTTP [NC]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/+(.*?)(?:\.html)?/?(?:\?\S*)?\sHTTP [NC]
RewriteRule ^ https://www.explorerhydepark.com/%1 [R=301,L]

# --- 3. Internally map extensionless URLs to their .html files on disk.
# No external redirect (no R flag) — must stay last so it never re-enters
# rule 2. Real files (robots.txt, sitemap.xml, assets/...) and real
# directories are untouched since they don't satisfy these conditions.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# --- 4. Browser caching (PageSpeed "efficient cache lifetimes").
# CSS/JS are always linked with ?v=<content hash> by the build, so a new file
# gets a new URL — they can be cached for a year. Photos keep their names when
# replaced, so they get 30 days. HTML is never cached long (prices change).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpe?g|png|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# --- 5. Compression for text files (usually on already; harmless if so).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript text/javascript application/json application/xml image/svg+xml
</IfModule>
