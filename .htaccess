Options -MultiViews
RewriteEngine On

# Old "Taony" slug (typo) -> corrected "Tawny" slug.
RewriteRule ^projects/hyde-park-taony/?$ /projects/hyde-park-tawny [R=301,L]
RewriteRule ^projects/hyde-park-taony\.html$ /projects/hyde-park-tawny [R=301,L]

# Redirect requests for *.html to extensionless URLs.
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# Internally map extensionless URLs to existing .html files.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
